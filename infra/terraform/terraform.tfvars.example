# Copy to terraform.tfvars locally. Do not commit account IDs, credentials or secrets.
aws_region                     = "us-east-1"
project_name                   = "private-family-os"
environment                    = "development"
vpc_id                         = "vpc-REPLACE_ME"
private_subnet_ids             = ["subnet-REPLACE_ME_A", "subnet-REPLACE_ME_B"]
api_security_group_id          = "sg-REPLACE_ME"
database_instance_class        = "db.t4g.medium"
database_backup_retention_days = 7
deletion_protection            = false
force_destroy_object_storage   = false
